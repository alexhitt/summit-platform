// Summit Platform Database Schema
// This defines all the tables for events, speakers, registrations, and giveaways

generator client {
  provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
      url      = env("DATABASE_URL")
      }

      // ==================== USER & AUTH ====================

      model User {
        id            String    @id @default(cuid())
          name          String?
            email         String?   @unique
              emailVerified DateTime?
                image         String?
                  role          UserRole  @default(USER)
                    createdAt     DateTime  @default(now())
                      updatedAt     DateTime  @updatedAt

                        accounts      Account[]
                          sessions      Session[]
                            speakerProfile SpeakerProfile?
                              hostedEvents  Event[]         @relation("EventHost")
                                registrations Registration[]
                                  affiliateLinks AffiliateLink[]
                                  }

                                  model Account {
                                    id                String  @id @default(cuid())
                                      userId            String
                                        type              String
                                          provider          String
                                            providerAccountId String
                                              refresh_token     String? @db.Text
                                                access_token      String? @db.Text
                                                  expires_at        Int?
                                                    token_type        String?
                                                      scope             String?
                                                        id_token          String? @db.Text
                                                          session_state     String?

                                                            user User @relation(fields: [userId], references: [id], onDelete: Cascade)

                                                              @@unique([provider, providerAccountId])
                                                              }

                                                              model Session {
                                                                id           String   @id @default(cuid())
                                                                  sessionToken String   @unique
                                                                    userId       String
                                                                      expires      DateTime
                                                                        user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
                                                                        }

                                                                        enum UserRole {
                                                                          USER
                                                                            HOST
                                                                              SPEAKER
                                                                                ADMIN
                                                                                }

                                                                                // ==================== SPEAKER PROFILES ====================

                                                                                model SpeakerProfile {
                                                                                  id          String   @id @default(cuid())
                                                                                    userId      String   @unique
                                                                                      headline    String?
                                                                                        bio         String?  @db.Text
                                                                                          website     String?
                                                                                            linkedin    String?
                                                                                              twitter     String?
                                                                                                facebook    String?
                                                                                                  country     String?
                                                                                                    isFeatured  Boolean  @default(false)
                                                                                                      isPublished Boolean  @default(false)
                                                                                                        createdAt   DateTime @default(now())
                                                                                                          updatedAt   DateTime @updatedAt
                                                                                                          
                                                                                                            user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
                                                                                                              presentations Presentation[]
                                                                                                                businessAreas SpeakerBusinessArea[]
                                                                                                                  topics        SpeakerTopic[]
                                                                                                                    applications  SpeakerApplication[]
                                                                                                                      eventSpeakers EventSpeaker[]
                                                                                                                      }
                                                                                                                      
                                                                                                                      model Presentation {
                                                                                                                        id          String   @id @default(cuid())
                                                                                                                          speakerId   String
                                                                                                                            title       String
                                                                                                                              description String?  @db.Text
                                                                                                                                imageUrl    String?
                                                                                                                                  bookingUrl  String?
                                                                                                                                    createdAt   DateTime @default(now())
                                                                                                                                      updatedAt   DateTime @updatedAt
                                                                                                                                      
                                                                                                                                        speaker       SpeakerProfile            @relation(fields: [speakerId], references: [id], onDelete: Cascade)
                                                                                                                                          businessAreas PresentationBusinessArea[]
                                                                                                                                            topics        PresentationTopic[]
                                                                                                                                            }
                                                                                                                                            
                                                                                                                                            // ==================== EVENTS / SUMMITS ====================
                                                                                                                                            
                                                                                                                                            model Event {
                                                                                                                                              id                String      @id @default(cuid())
                                                                                                                                                hostId            String
                                                                                                                                                  title             String
                                                                                                                                                    description       String?     @db.Text
                                                                                                                                                      imageUrl          String?
                                                                                                                                                        bannerUrl         String?
                                                                                                                                                          eventType         EventType   @default(SUMMIT)
                                                                                                                                                            status            EventStatus @default(DRAFT)
                                                                                                                                                              timezone          String      @default("America/New_York")
                                                                                                                                                                startDate         DateTime
                                                                                                                                                                  endDate           DateTime
                                                                                                                                                                    registrationEnd   DateTime?
                                                                                                                                                                      maxRegistrations  Int?
                                                                                                                                                                        isAcceptingSpeakers Boolean   @default(false)
                                                                                                                                                                          speakerDeadline   DateTime?
                                                                                                                                                                            createdAt         DateTime    @default(now())
                                                                                                                                                                              updatedAt         DateTime    @updatedAt
                                                                                                                                                                              
                                                                                                                                                                                host              User                 @relation("EventHost", fields: [hostId], references: [id])
                                                                                                                                                                                  businessAreas     EventBusinessArea[]
                                                                                                                                                                                    topics            EventTopic[]
                                                                                                                                                                                      registrations     Registration[]
                                                                                                                                                                                        speakers          EventSpeaker[]
                                                                                                                                                                                          applications      SpeakerApplication[]
                                                                                                                                                                                          }
                                                                                                                                                                                          
                                                                                                                                                                                          model EventSpeaker {
                                                                                                                                                                                            id            String   @id @default(cuid())
                                                                                                                                                                                              eventId       String
                                                                                                                                                                                                speakerId     String
                                                                                                                                                                                                  talkTitle     String?
                                                                                                                                                                                                    talkDescription String? @db.Text
                                                                                                                                                                                                      status        SpeakerStatus @default(CONFIRMED)
                                                                                                                                                                                                        order         Int      @default(0)
                                                                                                                                                                                                          createdAt     DateTime @default(now())
                                                                                                                                                                                                          
                                                                                                                                                                                                            event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                              speaker SpeakerProfile @relation(fields: [speakerId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                              
                                                                                                                                                                                                                @@unique([eventId, speakerId])
                                                                                                                                                                                                                }
                                                                                                                                                                                                                
                                                                                                                                                                                                                model SpeakerApplication {
                                                                                                                                                                                                                  id          String            @id @default(cuid())
                                                                                                                                                                                                                    eventId     String
                                                                                                                                                                                                                      speakerId   String
                                                                                                                                                                                                                        talkTitle   String
                                                                                                                                                                                                                          talkDescription String?       @db.Text
                                                                                                                                                                                                                            status      ApplicationStatus @default(PENDING)
                                                                                                                                                                                                                              createdAt   DateTime          @default(now())
                                                                                                                                                                                                                                updatedAt   DateTime          @updatedAt
                                                                                                                                                                                                                                
                                                                                                                                                                                                                                  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                    speaker SpeakerProfile @relation(fields: [speakerId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                      @@unique([eventId, speakerId])
                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                      enum EventType {
                                                                                                                                                                                                                                        MEETING
                                                                                                                                                                                                                                          WORKSHOP
                                                                                                                                                                                                                                            SUMMIT
                                                                                                                                                                                                                                              WEBINAR
                                                                                                                                                                                                                                                CHALLENGE
                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                enum EventStatus {
                                                                                                                                                                                                                                                  DRAFT
                                                                                                                                                                                                                                                    PUBLISHED
                                                                                                                                                                                                                                                      LIVE
                                                                                                                                                                                                                                                        COMPLETED
                                                                                                                                                                                                                                                          CANCELLED
                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                          enum SpeakerStatus {
                                                                                                                                                                                                                                                            PENDING
                                                                                                                                                                                                                                                              CONFIRMED
                                                                                                                                                                                                                                                                DECLINED
                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                enum ApplicationStatus {
                                                                                                                                                                                                                                                                  PENDING
                                                                                                                                                                                                                                                                    ACCEPTED
                                                                                                                                                                                                                                                                      REJECTED
                                                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                      // ==================== REGISTRATIONS ====================
                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                      model Registration {
                                                                                                                                                                                                                                                                        id        String             @id @default(cuid())
                                                                                                                                                                                                                                                                          eventId   String
                                                                                                                                                                                                                                                                            userId    String?
                                                                                                                                                                                                                                                                              email     String
                                                                                                                                                                                                                                                                                name      String?
                                                                                                                                                                                                                                                                                  status    RegistrationStatus @default(REGISTERED)
                                                                                                                                                                                                                                                                                    source    String?
                                                                                                                                                                                                                                                                                      affiliateId String?
                                                                                                                                                                                                                                                                                        createdAt DateTime           @default(now())
                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                          event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                            user      User?          @relation(fields: [userId], references: [id])
                                                                                                                                                                                                                                                                                              affiliate AffiliateLink? @relation(fields: [affiliateId], references: [id])
                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                @@unique([eventId, email])
                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                enum RegistrationStatus {
                                                                                                                                                                                                                                                                                                  REGISTERED
                                                                                                                                                                                                                                                                                                    ATTENDED
                                                                                                                                                                                                                                                                                                      NO_SHOW
                                                                                                                                                                                                                                                                                                        CANCELLED
                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                        // ==================== GIVEAWAYS ====================
                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                        model Giveaway {
                                                                                                                                                                                                                                                                                                          id            String        @id @default(cuid())
                                                                                                                                                                                                                                                                                                            title         String
                                                                                                                                                                                                                                                                                                              description   String?       @db.Text
                                                                                                                                                                                                                                                                                                                imageUrl      String?
                                                                                                                                                                                                                                                                                                                  startDate     DateTime
                                                                                                                                                                                                                                                                                                                    endDate       DateTime
                                                                                                                                                                                                                                                                                                                      status        GiveawayStatus @default(DRAFT)
                                                                                                                                                                                                                                                                                                                        createdAt     DateTime      @default(now())
                                                                                                                                                                                                                                                                                                                          updatedAt     DateTime      @updatedAt
                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                            entries GiveawayEntry[]
                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                            model GiveawayEntry {
                                                                                                                                                                                                                                                                                                                              id          String   @id @default(cuid())
                                                                                                                                                                                                                                                                                                                                giveawayId  String
                                                                                                                                                                                                                                                                                                                                  email       String
                                                                                                                                                                                                                                                                                                                                    name        String?
                                                                                                                                                                                                                                                                                                                                      createdAt   DateTime @default(now())
                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                        giveaway Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                          @@unique([giveawayId, email])
                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                          enum GiveawayStatus {
                                                                                                                                                                                                                                                                                                                                            DRAFT
                                                                                                                                                                                                                                                                                                                                              ACTIVE
                                                                                                                                                                                                                                                                                                                                                COMPLETED
                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                // ==================== AFFILIATES ====================
                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                model AffiliateLink {
                                                                                                                                                                                                                                                                                                                                                  id        String   @id @default(cuid())
                                                                                                                                                                                                                                                                                                                                                    userId    String
                                                                                                                                                                                                                                                                                                                                                      code      String   @unique
                                                                                                                                                                                                                                                                                                                                                        eventId   String?
                                                                                                                                                                                                                                                                                                                                                          createdAt DateTime @default(now())
                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                            user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                              registrations Registration[]
                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                              // ==================== CATEGORIES & TAGS ====================
                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                              model BusinessArea {
                                                                                                                                                                                                                                                                                                                                                                id   String @id @default(cuid())
                                                                                                                                                                                                                                                                                                                                                                  name String @unique
                                                                                                                                                                                                                                                                                                                                                                    slug String @unique
                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                      speakers      SpeakerBusinessArea[]
                                                                                                                                                                                                                                                                                                                                                                        presentations PresentationBusinessArea[]
                                                                                                                                                                                                                                                                                                                                                                          events        EventBusinessArea[]
                                                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                          model Topic {
                                                                                                                                                                                                                                                                                                                                                                            id   String @id @default(cuid())
                                                                                                                                                                                                                                                                                                                                                                              name String @unique
                                                                                                                                                                                                                                                                                                                                                                                slug String @unique
                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                  speakers      SpeakerTopic[]
                                                                                                                                                                                                                                                                                                                                                                                    presentations PresentationTopic[]
                                                                                                                                                                                                                                                                                                                                                                                      events        EventTopic[]
                                                                                                                                                                                                                                                                                                                                                                                      }
                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                      // Junction tables for many-to-many relationships
                                                                                                                                                                                                                                                                                                                                                                                      model SpeakerBusinessArea {
                                                                                                                                                                                                                                                                                                                                                                                        speakerId      String
                                                                                                                                                                                                                                                                                                                                                                                          businessAreaId String
                                                                                                                                                                                                                                                                                                                                                                                            speaker        SpeakerProfile @relation(fields: [speakerId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                              businessArea   BusinessArea   @relation(fields: [businessAreaId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                @@id([speakerId, businessAreaId])
                                                                                                                                                                                                                                                                                                                                                                                                }
                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                model SpeakerTopic {
                                                                                                                                                                                                                                                                                                                                                                                                  speakerId String
                                                                                                                                                                                                                                                                                                                                                                                                    topicId   String
                                                                                                                                                                                                                                                                                                                                                                                                      speaker   SpeakerProfile @relation(fields: [speakerId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                        topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                          @@id([speakerId, topicId])
                                                                                                                                                                                                                                                                                                                                                                                                          }
                                                                                                                                                                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                                                                                                                                                                          model PresentationBusinessArea {
                                                                                                                                                                                                                                                                                                                                                                                                            presentationId String
                                                                                                                                                                                                                                                                                                                                                                                                              businessAreaId String
                                                                                                                                                                                                                                                                                                                                                                                                                presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                  businessArea   BusinessArea @relation(fields: [businessAreaId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                                                                                                                                                                    @@id([presentationId, businessAreaId])
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                                                                                                                                                                    model PresentationTopic {
                                                                                                                                                                                                                                                                                                                                                                                                                      presentationId String
                                                                                                                                                                                                                                                                                                                                                                                                                        topicId        String
                                                                                                                                                                                                                                                                                                                                                                                                                          presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                            topic          Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                                                                                                                                              @@id([presentationId, topicId])
                                                                                                                                                                                                                                                                                                                                                                                                                              }
                                                                                                                                                                                                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                                                                                                                                                                              model EventBusinessArea {
                                                                                                                                                                                                                                                                                                                                                                                                                                eventId        String
                                                                                                                                                                                                                                                                                                                                                                                                                                  businessAreaId String
                                                                                                                                                                                                                                                                                                                                                                                                                                    event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                                      businessArea   BusinessArea @relation(fields: [businessAreaId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                                                                                                                                                                                                        @@id([eventId, businessAreaId])
                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                        model EventTopic {
                                                                                                                                                                                                                                                                                                                                                                                                                                          eventId String
                                                                                                                                                                                                                                                                                                                                                                                                                                            topicId String
                                                                                                                                                                                                                                                                                                                                                                                                                                              event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                                                topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
                                                                                                                                                                                                                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                                                                                                                                                                                                                  @@id([eventId, topicId])
                                                                                                                                                                                                                                                                                                                                                                                                                                                  }
